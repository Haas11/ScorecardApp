# Secrets — never commit
.env
*.env
**/.env

# Python
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/

# Models / large binaries (re-downloadable)
*.pth
*.onnx

# Databases + generated exports (DB is source of truth; export regenerates)
*.db
*.sqlite
*.sqlite3
*.xlsx

# Generated pipeline artifacts (regenerable from source images)
images/rows/
images/rows_enhanced*/
images/step1_cache/
images/stats_crop/
images/**/_*.png
**/step2_debug.txt

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
~$$*
