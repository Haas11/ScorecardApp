# Secrets — never commit
.env
*.env
**/.env

# Python
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/

# Models / large binaries (re-downloadable)
*.pth
*.onnx

# Databases + generated exports (DB is source of truth; export regenerates)
*.db
*.sqlite
*.sqlite3
*.xlsx

# Generated pipeline artifacts (regenerable from source images)
**/rows/
**/rows_enhanced*/
**/step1_cache/
**/stats_crop/
images/**/_*.png
**/step2_debug.txt

# Subdirectory cache dirs (ground-truth caches belong only in images/totals_cache/ and images/player_stats_cache/)
images/*/totals_cache/
images/*/player_stats_cache/
images/scorecard/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
~$$*
