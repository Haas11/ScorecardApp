# Secrets — never commit
.env
*.env
**/.env

# Python
__pycache__/
*.py[cod]
.venv/
**/.venv/
*.egg-info/

# Models / large binaries (re-downloadable)
*.pth
*.onnx

# Databases + generated exports (DB is source of truth; export regenerates)
*.db
*.sqlite
*.sqlite3
*.xlsx

# NOTE: the per-cell cache (Quick 2026/games/*/cells/) is deliberately TRACKED —
# it holds hand-corrected cells and is the source the pipeline rebuilds from.
# (The old "Quick 2026 data/" pattern below never matched the current folder.)
Quick 2026 data/games/*/cells/
**/step2_debug.txt
# Ad-hoc cache backups
*/cache_backup_*.zip

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
~$*
~$$*

# eval_cells.py predictions and error crops (regenerable)
scorecard/eval_out/
